# ==============================================================================
# ENTERPRISE KNOWLEDGE AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Duplicate this file as '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file to Git!
# ==============================================================================

# ── 1. Google Gemini AI (LLM & Embeddings) ───────────────────────────────────
# Required for RAG synthesis, Text-to-SQL reasoning, and 3072-dim embeddings.
# Get a free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── 2. Qdrant Cloud (Vector Database) ─────────────────────────────────────────
# Required for persistent high-dimensional vector search across company policies.
# Create a free cluster at: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ── 3. Supabase Cloud (Chat Auditing & Persistence) ──────────────────────────
# Stores chat history, response latency, and user telemetry.
# Create a free project at: https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── 4. Upstash Serverless Redis (Distributed Caching) ─────────────────────────
# Powers persistent, low-latency (<25ms) query caching across server restarts.
# Create a free serverless Redis database at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ── 5. LangSmith (Observability & Distributed Tracing) ────────────────────────
# Captures end-to-end token latency, retriever chunk scores, and LLM calls.
# Create a free account at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=enterprise-knowledge-agent
LANGCHAIN_ENVIRONMENT=Production
LANGSMITH_DISABLE_RUN_COMPRESSION=true

# ── 6. Cloud Web Service Deployment (Render / Hugging Face) ───────────────────
# Injected automatically by Render / Hugging Face; defaults to 7860 locally.
PORT=7860
API_HOST=0.0.0.0
API_PORT=8000
